# ===================
# LOCAL-ONLY FILES
# ===================

# Local planning and research docs
plans/
notes/
research/
TODO.local.md

# Deploy scripts and keys (contain private keys)
scripts/
secrets/

# Deployment config (local/generated, do not commit).
# Anchored to repo root so it does NOT match internal/deployment/ (Go source)
# or the committed deployments/addresses.json manifest. See ADDR-01.
/deployment/

research/

# Local planning docs (project-specific)
moltbunker/

# Infrastructure management (contains secrets, SSH keys, credentials)
management/

# Ignore configs/ contents (local/operator daemon.yaml etc.) but allow specific
# committed codegen artifacts to be re-included. Use configs/* (not configs/) so
# git can traverse the dir; a bare configs/ rule blocks file-level negation.
configs/*
# addresses-fragment.yaml is a deliberately committed codegen artifact
# (human-readable reference generated from deployments/addresses.json). See ADDR-01.
!configs/addresses-fragment.yaml
# configs/apparmor/ holds the committed moltbunker-container AppArmor profile and
# its SELinux note — shipped in-repo and embedded into the daemon binary. Re-include
# the dir (so git can traverse it) and its non-secret policy text files. See HARDEN-01.
!configs/apparmor/
!configs/apparmor/moltbunker-container
!configs/apparmor/moltbunker-container.selinux-note

docs/

# Bruno API collection (local testing only).
# Scoped to the collection dir: a bare "api/" also ignored internal/api/ (Go
# package) and the root api/openapi.yaml spec, silently dropping new source files.
api/bruno/

